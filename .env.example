# Optional read-only mailbox connection. Configure only providers you use.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SAMPOAGENT_GOOGLE_REDIRECT_URI=http://127.0.0.1:8765/email/callback/gmail

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
SAMPOAGENT_MICROSOFT_REDIRECT_URI=http://127.0.0.1:8765/email/callback/microsoft

# Generate once with:
# py -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key private and backed up. If it is lost, disconnect and reconnect email.
SAMPOAGENT_TOKEN_ENCRYPTION_KEY=

# Optional official Job Market Finland API access (KEHA-issued key required).
KIPA_SUBSCRIPTION_KEY=

# Optional local OCR for scanned CV PDFs (install the OCR extra and Tesseract binary/language packs).
# Provider is selected in Settings; "environment" reads this value.
SAMPOAGENT_OCR_PROVIDER=none
SAMPOAGENT_OCR_LANGUAGES=eng+fin+swe
# Optional full path when Tesseract is not on PATH.
SAMPOAGENT_TESSERACT_CMD=
